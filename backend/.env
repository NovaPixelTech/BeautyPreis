# BeautyPreis Configuration
# ======================
# To activate Douglas Germany official API integration, add your credentials below.
# Obtain credentials from the Douglas partner program.

# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beauty_preis"

# Server configuration
PORT=3011
NODE_ENV="development"

# Douglas Germany Official API credentials
# Uncomment and fill in your credentials to activate the Douglas integration
DOUGLAS_CLIENT_ID="your_douglas_client_id_here"
DOUGLAS_CLIENT_SECRET="your_douglas_client_secret_here"

# Optional: Override default API base URL
# DOUGLAS_API_BASE_URL="https://api.douglas.de/v1"

# Optional: Rate limit (requests per minute, default: 60)
# DOUGLAS_RATE_LIMIT=60